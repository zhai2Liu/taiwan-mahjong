{
  "name": "taiwan-mahjong",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "node scripts/prepare-training.mjs && tsc",
    "check:docs": "node scripts/check-doc-links.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "verify:release": "node scripts/verify-release.mjs",
    "test": "npm run check && node --test test/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:history": "npm run build && node scripts/browser-history.mjs",
    "benchmark:browser": "npm run build && node scripts/browser-baseline.mjs",
    "simulate": "npm run check && node scripts/simulate.mjs",
    "predev": "node scripts/prepare-training.mjs",
    "stats:ai": "npm run check && node scripts/ai-stats.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "typescript": "~5.9.3",
    "vite": "8.3.2"
  }
}
